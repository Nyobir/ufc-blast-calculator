    given-names: Vladyslav D.
    email: v.d.kochkarov@nuwm.edu.ua
    affiliation: "National University of Water and Environmental Engineering"
repository-code: "https://github.com/Nyobir/ufc-blast-calculator"
license: MIT
version: "1.2.1"
keywords:
  - blast loading
  - UFC 3-340-02
  - reflected pressure
  - Friedlander waveform
  - facade
  - reference data
